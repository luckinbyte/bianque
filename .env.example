# ===== Bianque 配置示例 =====
# 拷贝为 .env 并按需修改。所有值都可被环境变量覆盖。

# 网络绑定:局域网共享用 0.0.0.0;仅本机用 127.0.0.1
HOST=0.0.0.0
PORT=8000

# 访问服务的共享密码(必填;为空则拒绝启动)。
# 团队成员在网页"设置"里填入同样的值,作为 X-App-Token 提交。
APP_PASSWORD=change-me-to-a-strong-secret

# 允许分析的源码根目录(多个用冒号 : 分隔;绝对路径)。
# 工具只能读取这些目录内的文件,任何逃逸尝试一律拒绝。
ALLOWED_ROOTS=/home/code:/srv/repos

# 最大并发 agent 会话数(超出排队或返回 503)
MAX_CONCURRENT_SESSIONS=8

# 会话空闲超时(秒);超时自动清理,内存中的 apikey 一并清除
SESSION_IDLE_TIMEOUT=1800

# 默认 provider / 模型(浏览器设置可覆盖)。provider ∈ openai_compat | anthropic | local
DEFAULT_PROVIDER=openai_compat
DEFAULT_MODEL=

# 可选:直接由 app 提供 TLS(生产更推荐前置 caddy/nginx 自动证书)
# TLS_CERT=/path/to/cert.pem
# TLS_KEY=/path/to/key.pem
