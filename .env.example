# ===== Bianque 配置示例 =====
# 拷贝为 .env 并按需修改。所有值都可被环境变量覆盖。

# 网络绑定:局域网共享用 0.0.0.0;仅本机用 127.0.0.1
HOST=0.0.0.0
PORT=8000

# 统一分析目录(必填):所有会话共用这一个目录,agent 只能读它内部的文件。
REPO_ROOT=/home/code/myproject

# LLM provider 配置(必填,服务端统一,前端不可改)。provider ∈ openai_compat | anthropic | local
PROVIDER=openai_compat
BASE_URL=https://open.bigmodel.cn/api/paas/v4
MODEL=glm-4.5

# 上下文窗口上限(token),用于前端进度条。按你实际使用的模型填写。
CONTEXT_WINDOW=200000

# 最大并发 agent 会话数(超出返回 503)
MAX_CONCURRENT_SESSIONS=8

# 会话空闲超时(秒);超时自动清理,内存中的 apikey 一并清除
SESSION_IDLE_TIMEOUT=1800

# 项目导航 markdown(可选):管理员预先写好的本仓库介绍 / 摘要 / 导航。
# 启动时读取一次,内容会拼接到主 agent 与 explore 子 agent 的系统提示词,
# 帮助扁鹊更好地梳理用户问题。仅服务端持有,不会返回前端。
# 留空则不注入;若填了路径但文件不存在/不可读,会打一条 warning 并跳过(服务照常启动)。
# PROJECT_GUIDE=/path/to/project-guide.md

# 注意:本服务默认不设访问密码,任何能访问端口的人都可使用上面配置的 provider 与分析目录。
# 若暴露在不可信网络,请用反向代理(caddy/nginx)加访问控制。
# 可选:直接由 app 提供 TLS(生产更推荐前置 caddy/nginx 自动证书)
# TLS_CERT=/path/to/cert.pem
# TLS_KEY=/path/to/key.pem
